{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "dotiphant",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "skip-changelog": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Performance" },
        { "type": "revert", "section": "Reverted" },
        { "type": "refactor", "section": "Changed" },
        { "type": "docs", "section": "Documentation" },
        { "type": "build", "section": "Build and dependencies" },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": "server.json", "jsonpath": "$.version" },
        { "type": "json", "path": "server.json", "jsonpath": "$.packages[0].version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value==='dotiphant')].version" },
        { "type": "json", "path": "site/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
